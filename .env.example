# =====================================================================
#  Copia este archivo como .env.local y llena los valores.
#  .env.local NUNCA se sube a GitHub (ya está en .gitignore).
#  Todas son NEXT_PUBLIC_*: se ven en el navegador, así que aquí solo van
#  datos públicos. NUNCA pongas la service_role key en este proyecto.
# =====================================================================

# Supabase → Project Settings → API (o "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La "anon public" key (legacy) o la "publishable" key (sb_publishable_...). Cualquiera sirve.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# WhatsApp: código de país + número, solo dígitos, SIN "+" ni espacios. Ej. Colombia: 57 + 3001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567
# Nombre que aparece en el saludo: "Hola Felipe, quiero..."
NEXT_PUBLIC_SELLER_NAME=Felipe

# Nombre del negocio (encabezado, título de la pestaña y hoja del QR)
NEXT_PUBLIC_BUSINESS_NAME=Sabor de Cancha

# URL pública del sitio. Local: http://localhost:3000 · Producción: https://tu-app.vercel.app
# El QR apunta a esta URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
